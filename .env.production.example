# Production settings. On the server, copy this file to ".env" (next to docker-compose.yml), fill
# it in, and keep it out of git and out of backups that leave the server.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- Database (used by docker-compose.yml to create the database and build DATABASE_URL) ----
POSTGRES_DB=dr_ovi_dental
POSTGRES_USER=dr_ovi
# Letters and digits only (it is placed inside a URL). Use a long random value.
POSTGRES_PASSWORD=

# Not using docker-compose (managed database, Railway, Render…)? Set the full address instead:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# ---- App ----
# The public address of the site, with https and no trailing slash.
BETTER_AUTH_URL=https://your-domain.example
# At least 32 random characters. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Encrypts the SMTP password stored in the database: 32 random bytes as base64 or 64 hex characters.
# Losing it means re-entering the SMTP password; it is not needed to restore anything else.
EMAIL_ENCRYPTION_KEY=

# How many proxies sit in front of the app (Nginx = 1; Cloudflare + Nginx = 2). Used for rate limits.
TRUSTED_PROXY_HOPS=1

# ---- First administrator (used once by the seed command; it asks for the password) ----
ADMIN_NAME=
ADMIN_EMAIL=
