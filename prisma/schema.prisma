generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum TreatmentPlanStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  BANK_TRANSFER
}

enum PaymentStatus {
  POSTED
  REFUNDED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum AppointmentSource {
  DIRECT
  WHATSAPP
  ADMIN
  WALK_IN
}

enum ToothCondition {
  HEALTHY
  CARIES
  FILLED
  CROWN
  ROOT_CANAL
  IMPLANT
  FRACTURED
  MISSING
  EXTRACTED
  OTHER
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  LAB_FEES
  EQUIPMENT
  SALARY
  MARKETING
  MAINTENANCE
  OTHER
}

// PURCHASE adds a batch, ISSUE is stock used in the clinic, ADJUSTMENT is a manual correction
// (positive or negative) such as a stock-take difference, damage or expiry write-off.
enum StockMovementType {
  PURCHASE
  ISSUE
  ADJUSTMENT
}

enum QrLoginStatus {
  WAITING
  SCANNED
  APPROVED
  EXPIRED
  CANCELLED
  CONSUMED
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  // A deactivated account keeps its history but can no longer sign in or use any session.
  isActive      Boolean   @default(true)
  // Mobile number of the staff member (digits as typed, spaces and dashes removed).
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  treatmentSessions TreatmentSession[]
  prescriptions Prescription[]
  auditEvents AuditEvent[]
  qrLoginSessions QrLoginSession[]
  examinations ExaminationRecord[]
  dentalChartUpdates DentalChartEntry[]
  expenses Expense[]
  stockMovements StockMovement[]
  stockPurchases StockPurchase[]
  cashClosings CashClosing[]
  passwordResetOtps PasswordResetOtp[]
  passwordResetAuthorizations PasswordResetAuthorization[]
  emailAuditLogs EmailAuditLog[]
  smsLogs SmsLog[]

  @@map("user")
}

model QrLoginSession {
  id                 String        @id @default(cuid())
  tokenHash          String        @unique
  desktopProofHash   String
  desktopCookieName  String        @unique
  status             QrLoginStatus @default(WAITING)
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  expiresAt          DateTime
  scannedAt          DateTime?
  approvedAt         DateTime?
  cancelledAt        DateTime?
  consumedAt         DateTime?
  createdAt          DateTime      @default(now())

  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Appointment {
  id           String            @id @default(cuid())
  patientId    String?
  patient      Patient?           @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName  String
  patientPhone String
  patientEmail String?
  service      String
  dateTime     DateTime
  status       AppointmentStatus @default(PENDING)
  source       AppointmentSource @default(DIRECT)
  durationMinutes Int            @default(30)
  serviceId    String?
  clinicService ClinicService?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  examinations ExaminationRecord[]
  notes        String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([dateTime])
  @@index([status, dateTime])
  @@index([patientId, dateTime])
  @@index([serviceId])
  @@index([source, dateTime])
  @@index([patientName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Appointment_patientName_trgm_idx")
  @@index([patientPhone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Appointment_patientPhone_trgm_idx")
  @@index([service(ops: raw("gin_trgm_ops"))], type: Gin, map: "Appointment_service_trgm_idx")
  @@index([id(ops: raw("gin_trgm_ops"))], type: Gin, map: "Appointment_id_trgm_idx")
}

model Patient {
  id                    String        @id @default(cuid())
  patientCode           String        @unique
  name                  String
  phone                 String
  isActive              Boolean       @default(true)
  email                 String?
  dateOfBirth           DateTime?     @db.Date
  address               String?       @db.Text
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalHistory        String?       @db.Text
  allergies             String?       @db.Text
  dentalHistory         String?       @db.Text
  notes                 String?       @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  appointments          Appointment[]
  treatmentPlans        TreatmentPlan[]
  prescriptions         Prescription[]
  invoices              Invoice[]
  examinations          ExaminationRecord[]
  dentalChart           DentalChartEntry[]
  reviews               ClinicReview[]

  @@index([phone])
  @@index([name])
  @@index([createdAt(sort: Desc), id])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_phone_trgm_idx")
  @@index([patientCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_patientCode_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_email_trgm_idx")
}

model DoctorProfile {
  id                 String   @id @default("primary")
  name               String
  qualifications     String   @default("")
  specialization     String   @default("Dentistry")
  registrationNumber String?
  consultationFee    Decimal  @default(0) @db.Decimal(12, 2)
  phone              String?
  email              String?
  address            String?  @db.Text
  bio                String?  @db.Text
  updatedAt          DateTime @updatedAt
  schedules          DoctorSchedule[]
}

model DoctorSchedule {
  id        String       @id @default(cuid())
  doctorId  String       @default("primary")
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  isWorking Boolean      @default(true)

  @@unique([doctorId, dayOfWeek])
}

model ClinicService {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String   @unique
  category        String   @default("General")
  description     String?  @db.Text
  // Optional Bangla text for the bilingual public website.
  nameBn          String?
  descriptionBn   String?  @db.Text
  // Public website presentation. Every field is optional; empty means "show the simple card".
  categoryBn      String?
  iconKey         String?
  badgeEn         String?
  badgeBn         String?
  timeTextEn      String?
  timeTextBn      String?
  painTextEn      String?
  painTextBn      String?
  feeMax          Decimal? @db.Decimal(12, 2)
  detailsEn       String   @default("") @db.Text
  detailsBn       String   @default("") @db.Text
  stepsEn         String[] @default([])
  stepsBn         String[] @default([])
  standardPrice   Decimal  @default(0) @db.Decimal(12, 2)
  durationMinutes Int      @default(30)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  appointments    Appointment[]
  invoiceItems    InvoiceItem[]

  @@index([category, isActive])
}

// Editable text and images of the public website. One row (id "primary"), like DoctorProfile.
// An empty text means "use the built-in wording", so a new or half-filled row never leaves a gap.
model ClinicContent {
  id                 String   @id @default("primary")
  clinicName         String   @default("")
  clinicSubtitle     String   @default("")
  heroTitleEn        String   @default("")
  heroTitleBn        String   @default("")
  heroSubtitleEn     String   @default("") @db.Text
  heroSubtitleBn     String   @default("") @db.Text
  technologyEn       String   @default("") @db.Text
  technologyBn       String   @default("") @db.Text
  bookingNoteEn      String   @default("") @db.Text
  bookingNoteBn      String   @default("") @db.Text
  closingMessageEn   String   @default("") @db.Text
  closingMessageBn   String   @default("") @db.Text
  doctorHighlightsEn String[] @default([])
  doctorHighlightsBn String[] @default([])
  heroImageUrl       String?
  doctorImageUrl     String?
  // Menu labels, section headings, feature cards, footer: overrides only (see website-layout.ts).
  layout             Json?
  updatedAt          DateTime @updatedAt
}

model ClinicReview {
  id        String       @id @default(cuid())
  name      String
  rating    Int
  comment   String       @db.Text
  status    ReviewStatus @default(PENDING)
  // The registered patient who wrote it. The mobile number used to check this is never stored here.
  // Reviews written before this check existed have no patient.
  patientId String?
  patient   Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([patientId])
}

model ClinicGalleryImage {
  id        String   @id @default(cuid())
  url       String   @db.Text
  altText   String   @db.VarChar(240)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, createdAt])
}

model TreatmentPlan {
  id            String                  @id @default(cuid())
  patientId     String
  patient       Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  diagnosis     String
  procedureName String
  toothNumbers  String[]                @default([])
  estimatedCost Decimal                 @db.Decimal(12, 2)
  status        TreatmentPlanStatus     @default(PLANNED)
  notes         String?                 @db.Text
  completedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  sessions      TreatmentSession[]

  @@index([patientId, createdAt])
  @@index([status, createdAt])
  @@index([updatedAt(sort: Desc), id])
}

model Prescription {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescribedById String?
  prescribedBy   User?    @relation(fields: [prescribedById], references: [id], onDelete: SetNull)
  diagnosis      String
  instructions   String?  @db.Text
  followUpDate   DateTime? @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  medications    PrescriptionMedication[]

  @@index([patientId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model PrescriptionMedication {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  name           String
  dosage         String
  frequency      String
  duration       String
  instructions   String?

  @@index([prescriptionId])
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceCode String        @unique
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  status      InvoiceStatus @default(ISSUED)
  subtotal    Decimal       @db.Decimal(12, 2)
  discount    Decimal       @default(0) @db.Decimal(12, 2)
  tax         Decimal       @default(0) @db.Decimal(12, 2)
  notes       String?       @db.Text
  issuedAt    DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       InvoiceItem[]
  payments    Payment[]

  @@index([patientId, issuedAt])
  @@index([status, issuedAt])
  @@index([issuedAt(sort: Desc), id(sort: Desc)])
}

model InvoiceItem {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  serviceId   String?
  service     ClinicService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  description String
  quantity    Int           @default(1)
  unitPrice   Decimal       @db.Decimal(12, 2)
  amount      Decimal       @db.Decimal(12, 2)

  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  status      PaymentStatus @default(POSTED)
  receivedAt  DateTime      @default(now())
  refundedAt  DateTime?
  note        String?       @db.Text

  @@index([invoiceId, receivedAt])
  @@index([status, receivedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt(sort: Desc)])
}

model TreatmentSession {
  id             String        @id @default(cuid())
  treatmentPlanId String
  treatmentPlan  TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Restrict)
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  performedAt    DateTime      @default(now())
  notes          String        @db.Text
  createdAt      DateTime      @default(now())

  @@index([treatmentPlanId, performedAt])
  @@index([createdById])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// A clinical visit record: what the patient reported, what the doctor found, and the diagnosis.
// Kept separate from Patient.medicalHistory (long-lived background) and from treatment plans
// (planned/performed procedures) so each visit stays a dated, auditable entry.
model ExaminationRecord {
  id             String       @id @default(cuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  examinedById   String?
  examinedBy     User?        @relation(fields: [examinedById], references: [id], onDelete: SetNull)
  examinedAt     DateTime     @default(now())
  chiefComplaint String       @db.Text
  findings       String?      @db.Text
  diagnosis      String
  notes          String?      @db.Text
  followUpDate   DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([patientId, examinedAt(sort: Desc)])
  @@index([appointmentId])
  @@index([followUpDate])
}

// Current state of one tooth for one patient (FDI two-digit notation, e.g. "16"). One row per
// patient and tooth; history lives in the audit log and in examination records.
model DentalChartEntry {
  id           String         @id @default(cuid())
  patientId    String
  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  toothNumber  String         @db.VarChar(2)
  condition    ToothCondition
  notes        String?        @db.Text
  updatedById  String?
  updatedBy    User?          @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([patientId, toothNumber])
}

// Clinic operating expense. Voided (not deleted) so financial history stays reconstructable.
model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  spentAt     DateTime        @db.Date
  method      PaymentMethod   @default(CASH)
  reference   String?
  voidedAt    DateTime?
  voidReason  String?
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  stockPurchase StockPurchase?

  @@index([spentAt(sort: Desc)])
  @@index([category, spentAt])
}


// ---- Inventory -------------------------------------------------------------------------------

model Supplier {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?  @db.Text
  notes         String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         InventoryItem[]
  purchases     StockPurchase[]
}

// A medicine or dental supply. `quantity` is the on-hand total and always equals the sum of its
// batches' remaining quantities; it is only changed together with a StockMovement, in one transaction.
model InventoryItem {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String   @unique
  category     String   @default("Dental supplies")
  unit         String   @default("pcs")
  quantity     Int      @default(0)
  reorderLevel Int      @default(0)
  // Unit cost of the most recent purchase; used for the stock value shown in reports.
  unitCost     Decimal  @default(0) @db.Decimal(12, 2)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  notes        String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  batches      StockBatch[]
  movements    StockMovement[]

  @@index([isActive, category])
  @@index([supplierId])
}

// One received lot. Expiry is tracked per lot, and stock is used oldest-expiry first.
model StockBatch {
  id                String        @id @default(cuid())
  itemId            String
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  purchaseId        String?
  purchase          StockPurchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  batchNumber       String?
  expiryDate        DateTime?     @db.Date
  quantityReceived  Int
  quantityRemaining Int
  unitCost          Decimal       @default(0) @db.Decimal(12, 2)
  receivedAt        DateTime      @default(now())
  movements         StockMovement[]

  @@index([itemId, quantityRemaining])
  @@index([expiryDate])
  @@index([purchaseId])
}

// Every change of stock, signed (+ in, - out). Never edited or deleted.
model StockMovement {
  id          String            @id @default(cuid())
  itemId      String
  item        InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchId     String?
  batch       StockBatch?       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  type        StockMovementType
  quantity    Int
  unitCost    Decimal?          @db.Decimal(12, 2)
  reason      String?
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([itemId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([type, createdAt])
}

model StockPurchase {
  id            String   @id @default(cuid())
  purchaseCode  String   @unique
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNumber String?
  purchasedAt   DateTime @db.Date
  totalCost     Decimal  @db.Decimal(12, 2)
  note          String?  @db.Text
  // The expense entry created with the purchase (when the clinic paid at purchase time).
  expenseId     String?  @unique
  expense       Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  batches       StockBatch[]

  @@index([purchasedAt(sort: Desc)])
  @@index([supplierId])
}

// ---- Daily cash closing ----------------------------------------------------------------------

// The end-of-day cash count. One row per clinic day. The figures are a snapshot taken at closing so
// the record stays the same even if entries are voided afterwards.
model CashClosing {
  id            String   @id @default(cuid())
  businessDate  DateTime @unique @db.Date
  openingCash   Decimal  @db.Decimal(12, 2)
  cashReceived  Decimal  @db.Decimal(12, 2)
  cashRefunded  Decimal  @db.Decimal(12, 2)
  cashExpenses  Decimal  @db.Decimal(12, 2)
  expectedCash  Decimal  @db.Decimal(12, 2)
  countedCash   Decimal  @db.Decimal(12, 2)
  difference    Decimal  @db.Decimal(12, 2)
  note          String?  @db.Text
  closedById    String?
  closedBy      User?    @relation(fields: [closedById], references: [id], onDelete: SetNull)
  closedAt      DateTime @default(now())

  @@index([businessDate(sort: Desc)])
}


// ---- Roles and permissions -------------------------------------------------------------------

// A named set of permissions. `key` is what user.role stores. The built-in roles (admin,
// receptionist, doctor, assistant, accountant) are created on first use with sensible defaults and
// can be re-configured, except "admin", which always holds every permission.
model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String   @unique
  description String   @default("")
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Email and password recovery -------------------------------------------------------------

enum EmailAuthMethod {
  APP_PASSWORD
  PASSWORD
}

// Outgoing mail settings. One row (id "primary"). The SMTP password is stored only as
// AES-256-GCM ciphertext (key kept in the environment, never in the database) and is never
// returned by any API; `passwordSet` is all the screen gets to see.
model EmailConfiguration {
  id                String          @id @default("primary")
  provider          String          @default("gmail")
  host              String          @default("smtp.gmail.com")
  port              Int             @default(465)
  secure            Boolean         @default(true)
  authMethod        EmailAuthMethod @default(APP_PASSWORD)
  username          String          @default("")
  encryptedPassword String?
  senderEmail       String          @default("")
  senderName        String          @default("Dr Ovi's Dental Care")
  enabled           Boolean         @default(false)
  // Result of the last connection test or test e-mail. Cleared whenever the connection settings change.
  lastTestAt        DateTime?
  lastTestStatus    String?
  lastTestMessage   String?
  updatedById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// A one-time password sent by e-mail. Only an HMAC of the code is stored, never the code.
model PasswordResetOtp {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String
  codeHash      String
  expiresAt     DateTime
  attempts      Int       @default(0)
  consumedAt    DateTime?
  invalidatedAt DateTime?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
  @@index([expiresAt])
}

// Proof that an OTP was verified. Short-lived and single-use; only a hash of the token is stored.
model PasswordResetAuthorization {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpId      String    @unique
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// What happened to e-mail settings and e-mail sending. Addresses are masked; codes and passwords never appear.
model EmailAuditLog {
  id        String   @id @default(cuid())
  action    String
  status    String
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  recipient String?
  message   String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt])
}

// ---- SMS (appointment notifications) ---------------------------------------------------------

// SMS gateway settings. One row (id "primary"). The API key is stored only as AES-256-GCM ciphertext
// (same key as the SMTP password, kept in the environment) and is never returned by any API.
model SmsConfiguration {
  id                  String   @id @default("primary")
  provider            String   @default("bulksmsbd")
  encryptedApiKey     String?
  senderId            String   @default("")
  enabled             Boolean  @default(false)
  // Text sent when an appointment is booked. Placeholders: {name} {date} {time} {clinic}.
  appointmentTemplate String   @default("")
  // Abuse and cost guards: SMS per phone number per day, and in total per day.
  perNumberDailyLimit Int      @default(3)
  dailyLimit          Int      @default(200)
  lastTestAt          DateTime?
  lastTestStatus      String?
  lastTestMessage     String?
  updatedById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Every SMS attempt and settings change. The phone number is masked for display and hashed for
// counting; the full number and the message text are not stored.
model SmsLog {
  id            String   @id @default(cuid())
  purpose       String
  status        String
  recipient     String?
  recipientHash String?
  providerCode  String?
  message       String?
  appointmentId String?
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([appointmentId])
}
